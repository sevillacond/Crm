# ==============================================================================
# ENLACE TELECOM CRM — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Instância Single-Tenant por Provedor / CNPJ
# ==============================================================================

# Execução e Porta
PORT=3000
NODE_ENV=production
APP_URL="https://crm.provedor.com.br"

# Identificação da Instância Isolada (Single-Tenant)
INSTANCE_ID="inst-enlace-fibra-001"
VITE_INSTANCE_ID="inst-enlace-fibra-001"
VITE_PROVEDOR_NOME="Enlace Telecomunicações"
VITE_CNPJ="14.892.341/0001-90"

# Segurança & Autenticação
# OBRIGATÓRIO EM PRODUÇÃO: mínimo 32 caracteres criptograficamente aleatórios
JWT_SECRET="CHANGE_ME_MINIMUM_32_CHAR_RANDOM_SECRET"
CORS_ORIGINS="https://crm.provedor.com.br"

# Administrador Inicial de Produção (Bootstrap)
ADMIN_INITIAL_EMAIL="admin@enlace.net.br"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_SECURE_ADMIN_PASSWORD"

# Banco de Dados Dedicado (PostgreSQL 16) - OBRIGATÓRIO EM PRODUÇÃO
POSTGRES_USER="enlace_user"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="enlace_crm_db"
DATABASE_URL="postgresql://enlace_user:CHANGE_ME@postgres:5432/enlace_crm_db?sslmode=disable"

# Cache de Sessão & Rate Limiting (Redis)
REDIS_URL="redis://redis:6379"

# Inteligência Artificial MaIA (Gemini 2.5 Flash via @google/genai)
GEMINI_API_KEY="CHANGE_ME"

# Canal Oficial WhatsApp Meta Cloud API
WHATSAPP_API_TOKEN="CHANGE_ME"
WHATSAPP_PHONE_NUMBER_ID="CHANGE_ME"
WHATSAPP_VERIFY_TOKEN="CHANGE_ME"

# SGP Integrado (IXC Soft, MK-AUTH, HubSoft, SGP)
SGP_INTEGRACAO="IXC_SOFT"
SGP_API_ENDPOINT="https://sgp.provedor.com.br/webservice/v1"
SGP_API_TOKEN="CHANGE_ME"

# Telefonia Asterisk PBX WebRTC SIP
ASTERISK_WEBRTC_WSS="wss://pbx.provedor.com.br:8089/ws"
STUN_SERVER="stun:stun.l.google.com:19302"
