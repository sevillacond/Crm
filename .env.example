# ==============================================================================
# ENLACE TELECOM CRM — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Instância Single-Tenant por Provedor
# ==============================================================================

# GEMINI_API_KEY: Necessária para o Co-piloto MaIA (Gemini 2.5 Flash via @google/genai)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base da aplicação
APP_URL="https://crm.provedor.com.br"

# Porta e Ambiente de Execução
PORT=3000
NODE_ENV=production

# Identificação da Instância Isolada
VITE_INSTANCE_ID="inst-enlace-fibra-001"
VITE_PROVEDOR_NOME="Enlace Telecomunicações"
VITE_CNPJ="14.892.341/0001-90"

# Banco de Dados Dedicado (PostgreSQL 16)
DATABASE_URL="postgresql://enlace_user:enlace_secret_2026@localhost:5432/enlace_crm_db?sslmode=disable"

# Cache de Sessão & Filas (Opcional - Redis)
REDIS_URL="redis://localhost:6379"

# Canal Oficial WhatsApp Meta Cloud API
WHATSAPP_API_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="109283746501928"
WHATSAPP_VERIFY_TOKEN="token_secreto_webhook_enlace"

# SGP Integrado (IXC Soft, MK-AUTH, HubSoft, SGP)
SGP_INTEGRACAO="IXC_SOFT"
SGP_API_ENDPOINT="https://sgp.provedor.com.br/webservice/v1"
SGP_API_TOKEN="token_autenticacao_sgp"

# Telefonia Asterisk PBX WebRTC SIP
ASTERISK_WEBRTC_WSS="wss://pbx.provedor.com.br:8089/ws"
STUN_SERVER="stun:stun.l.google.com:19302"
